# Copy to evm/.env.arbitrum and fill PRIVATE_KEY / ADMIN_ADDRESS (never commit the real file).
# See docs/DEPLOY_ARBITRUM.md for the step-by-step test deploy.
EVM_CLUSTER=arbitrum
HOOK_MODE=return-delta

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
FORK_CHAIN_ID=42161

# Generate with: cast wallet new
ADMIN_ADDRESS=
PRIVATE_KEY=

# Arbiscan / Etherscan V2 API key — required for make verify-arbitrum
# https://etherscan.io/apidashboard (V2 key works for Arbitrum)
ARBISCAN_API_KEY=

# Test: can equal ADMIN_ADDRESS. Change before any production lock.
DONATION_WALLET=
MARKETING_WALLET=

# Uniswap v4 — Arbitrum One
POOL_MANAGER=0x360e68faccca8ca495c1b759fd9eee466db9fb32
POSITION_MANAGER=0xd88f38f930b7952f2db2432cb002e7abbf3dd869
UNIVERSAL_ROUTER=0xa51afafe0263b40edaef0df8781ea9aa03e381a3
STATE_VIEW=0x76fd297e2d437cd7f76d50f01afe6160f86e9990
QUOTER=0x3972c00f7ed4885e145823eb7c655375d275a1c5
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Native USDC (Circle) on Arbitrum — not USDC.e
QUOTE_TOKEN_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
QUOTE_DECIMALS=6
USE_MOCK_USDC=false

# $20 LP at 0.001 USDC/PXT → 20,000 PXT
LP_SEED_USDC_WHOLE=20
LP_SEED_PXT_WHOLE=20000

# Must be in the future at broadcast time (unix seconds)
SELL_UNLOCK_TIMESTAMP=

BUYBACK_RECYCLE_WIDTH_SPACINGS=10
BUYBACK_MAX_SLIPPAGE_BPS=200

# Filled after make bootstrap-arbitrum
# PXT_ADDRESS=
# PHOENIX_HOOK=
# FEE_COLLECTOR=
# POOL_SWAP_TEST=
# ANTI_BOT_OPEN_SELL=
