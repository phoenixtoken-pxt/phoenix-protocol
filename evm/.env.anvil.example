# Copy to evm/.env.anvil - or run `make bootstrap-anvil`.
EVM_CLUSTER=anvil

# Local Anvil RPC (do not use for --fork-url; that needs real Base Sepolia)
ANVIL_RPC_URL=http://127.0.0.1:8545

# Anvil account #0 - admin / deployer
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Anvil accounts #1-#2 - fee wallets; #3 default NoPenalty demo (overridable via lists)
DONATION_WALLET=0x70997970c51812Dc3a010C7d01b50b0d17Ef88c8
MARKETING_WALLET=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
# Optional comma-separated lists (applied at bootstrap and/or make set-wallet-statuses-anvil).
# Must be set before make lock-anvil (Ownable renounce freezes setWalletStatus).
# Anvil #10 requires ANVIL_ACCOUNTS>=11 when starting the fork (Makefile default bumped).
FEE_EXEMPT_WALLETS=0xBcd4042DE499D14e55001CcbB24a551F3b954096
# NO_PENALTY_WALLETS=0x90F79bf6EB2c4f870365E785982E1f101E93b906,0x111...
# Legacy single NoPenalty (used when NO_PENALTY_WALLETS unset; bootstrap defaults Anvil #3):
NO_PENALTY_WALLET=0x90F79bf6EB2c4f870365E785982E1f101E93b906

# === Uniswap pool + Phoenix hook (filled by make bootstrap-anvil) ===
PXT_ADDRESS=
QUOTE_TOKEN_ADDRESS=
PHOENIX_HOOK=
FEE_COLLECTOR=
POOL_CURRENCY0=
POOL_CURRENCY1=
POOL_FEE=0
POOL_TICK_SPACING=60
POOL_MANAGER=0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408
POSITION_MANAGER=0x4b2c77d209d3405f41a037ec6c77f7f5b8e2ca80
UNIVERSAL_ROUTER=0x492e6456d9528771018deb9e87ef7750ef184104
POOL_SWAP_TEST=0x8B5bcC363ddE2614281aD875bad385E0A785D3B9
POOL_MODIFY_LIQUIDITY_TEST=0x37429cD17Cb1454C34E7F50b09725202Fd533039
STATE_VIEW=0x571291b572ed32ce6751a2Cb2486EbEe8DEfB9B4
QUOTER=0x4A6513c898fe1B2d0E78d3b0e0A4a151589B1cBa
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
# Anti-bot: after unlock use make open-trading-anvil (atomic clear + Admin sell).
# Hooks enforceTradingOpen until cleared. Default anti-bot seller = admin.
# ANTI_BOT_SELLER=      # ops operator EOA (funds openWithExactInSell); default Admin
# ANTI_BOT_OPEN_SELL=   # set by bootstrap (PhoenixAntiBotOpenSell = on-chain antiBotSeller)
# Prefer asymmetric seed at 0.001 USDC/PXT (defaults in BootstrapReturnDeltaFork):
# LP_SEED_PXT_WHOLE=210000000
# LP_SEED_USDC_WHOLE=210000
# Buyback params (set at bootstrap; cash-only USDC → PXT recycle, seed LP never peeled)
# BUYBACK_RECYCLE_WIDTH_SPACINGS=10
# Protocol MEV floor (bps vs spot; default 200 = 2%). Buyback swaps skip the 2.7% hook buy skim.
# Spot-referenced — prefer a keeper / private relay and a non-zero MIN_PXT_BOUGHT when executing.
# Frozen at renounce.
# BUYBACK_MAX_SLIPPAGE_BPS=200
# After LP seed, optional wallet lists then freeze admin:
#   make set-wallet-statuses-anvil  — apply FEE_EXEMPT_WALLETS / NO_PENALTY_WALLETS
#   make lock-anvil  — sellAttributor must be the hook
# RECIPIENT_APPROVER = Safe/multisig that keeps Pxt allowlist + DEFAULT_ADMIN_ROLE (required for lock).
# Must differ from the deployer (PRIVATE_KEY). Example: Anvil #4.
# RECIPIENT_APPROVER=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
# (optional: pass BUYBACK_* above to LockProtocolReturnDelta before renounce)
# execute-buyback-anvil:
# MIN_PXT_BOUGHT=0
# DEADLINE_SECONDS=600

USE_MOCK_USDC=true
QUOTE_DECIMALS=6

# Mint / distribute helpers (defaults for make fund-testers-anvil - #5-#9)
RECIPIENTS=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc,0x976EA74026E726554dB657fA54763abd0C3a0aa9,0x14dC79964da2C08b23698B3D3cc7Ca32193d9955,0x23618e81E3f5cdF7f54C3d65f7FBc0aBf5B21E8f,0xa0Ee7A142d267C1f36714E4a8F75612F20a79720
AMOUNT_WHOLE=10000
FUND_ETH=true
TESTER_ETH_AMOUNT=10ether
