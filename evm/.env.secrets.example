# Local secrets — gitignored. Copy to evm/.env.secrets and fill (never commit).
# Same JWT as pxt-protocol-v2 works: copy from ../pxt-protocol-v2/evm/.env.secrets

PINATA_JWT=
# URL prefix used in TOKEN_*_URI after pin (Pinata uploads; public gateway for reads).
PINATA_GATEWAY=https://ipfs.io/ipfs

# Optional override for metadata.json external_url (default: https://phoenixproject.community/)
# EXTERNAL_URL=https://phoenixproject.community/
